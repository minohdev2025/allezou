# Copier vers .env.local et adapter. .env.local n'est jamais versionné.

# Base de données
DATABASE_URL=postgresql://totir:totir@localhost:5433/totir

# Base utilisée par les tests — détruite et recréée à chaque exécution
TEST_DATABASE_URL=postgresql://totir:totir@localhost:5433/totir_test

# Adresse publique de l'app, utilisée pour construire les liens magiques et d'invitation
APP_URL=http://localhost:3000

# Secret de signature des sessions (openssl rand -base64 32)
SESSION_SECRET=

# Envoi des liens magiques (SMTP — Infomaniak en production)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Allezou <contact@allezou.ch>"

# Notifications push (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
# Meme valeur que ci-dessus, exposee au navigateur pour l abonnement push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@allezou.ch

# Qui peut relire la file de l agenda (adresses separees par des virgules)
ADMIN_EMAILS=

# Planificateur interne : 1 pour l activer en developpement, 0 pour le couper en production
SCHEDULER=

# Carte Google Maps sur l agenda et l ecran de sortie (docs/google-maps.md : creation de la
# cle, restriction au domaine, plafond de quota qui garantit le 0 franc). Sans cle, les
# cartes expliquent leur absence ; les liens vers Google Maps marchent, eux, sans rien.
# Lue a l execution par le serveur (pas NEXT_PUBLIC_) : la remplir puis redemarrer suffit.
GOOGLE_MAPS_API_KEY=
# Facultatif : Map ID pour le style de carte (DEMO_MAP_ID sinon, suffisant en developpement)
GOOGLE_MAPS_MAP_ID=
