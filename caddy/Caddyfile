# Proxy inverse de production. À déposer en /etc/caddy/Caddyfile sur le VPS.
#
# Le port 80 est fermé au pare-feu : Caddy obtient son certificat par le défi TLS-ALPN sur
# 443, sans rien demander de plus. Les en-têtes de sécurité viennent de l'application
# (src/proxy.ts et next.config.ts) — ne pas les redéfinir ici, deux valeurs pour un même
# en-tête et le navigateur n'en retient qu'une, ou aucune.

allezou.ch {
	# Le port 80 est fermé : inutile de laisser Caddy tenter le défi HTTP à chaque
	# renouvellement, il échoue par construction et retarde le défi qui marche. Et nommer
	# l'émetteur écarte le repli ZeroSSL, dont le service d'inscription réclamé par Caddy 2.6
	# a été retiré (« caddy_legacy_user_removed »).
	tls {
		issuer acme {
			disable_http_challenge
		}
	}

	reverse_proxy 127.0.0.1:4100

	# Sept jours au plus : une sortie apparaît dans une URL /sortie/<identifiant>, et des
	# journaux gardés des mois reviendraient à conserver la trace des sorties consultées.
	log {
		output file /var/log/caddy/allezou.log {
			roll_size 20MiB
			roll_keep_for 168h
		}
	}
}

# `www` ne sert à rien d'autre qu'à ne pas casser : l'en-tête HSTS porte `includeSubDomains`,
# et une fois le domaine préchargé, un `www` sans HTTPS valide devient une impasse pour qui
# l'a tapé par habitude. Ce bloc ne prend que lorsque `www.allezou.ch` pointe sur le VPS —
# sinon Caddy échoue à obtenir son certificat et réessaie en boucle.
www.allezou.ch {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}

	# Seul endroit où l'en-tête est écrit ici plutôt que par l'application : `www` ne traverse
	# aucune application, et une redirection sans HSTS laisse la première visite sur `www`
	# sans protection tant que le domaine n'est pas préchargé. Même valeur qu'en next.config.ts.
	header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

	redir https://allezou.ch{uri} permanent
}
